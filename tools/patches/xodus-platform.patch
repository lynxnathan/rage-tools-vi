+/* XSystem: the console's own identity. The interface order comes from include/xsystem.idl
+ * (IXSystemImpl5), so the object answers with real strings instead of E_NOINTERFACE. */
+static void write_string( char *buffer, INT32 size, SIZE_T *used, const char *text )
+{
+    SIZE_T length = strlen( text );
+    SIZE_T copy = length;
+
+    if ( buffer && size > 0 )
+    {
+        if ( copy > ( SIZE_T )size - 1 ) copy = ( SIZE_T )size - 1;
+        memcpy( buffer, text, copy );
+        buffer[copy] = 0;
+    }
+    if ( used ) *used = length;
+}
+
+class XSystemObject : public IXSystemImpl5
+{
+public:
+    HRESULT STDMETHODCALLTYPE QueryInterface( REFIID iid, void **out ) override
+    {
+        if ( !out ) return E_POINTER;
+        if ( IsEqualIID( iid, IID_IUnknown ) || IsEqualIID( iid, IID_IXSystemImpl5 )
+             || IsEqualIID( iid, IID_IXSystemImpl4 ) || IsEqualIID( iid, IID_IXSystemImpl3 )
+             || IsEqualIID( iid, IID_IXSystemImpl2 ) || IsEqualIID( iid, IID_IXSystemImpl ) )
+        {
+            *out = static_cast<IXSystemImpl5 *>( this );
+            return S_OK;
+        }
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return 1; }
+    ULONG STDMETHODCALLTYPE Release() override { return 1; }
+
+    HRESULT STDMETHODCALLTYPE XSystemGetConsoleId( INT32 size, char *id, SIZE_T *used ) override
+    {
+        write_string( id, size, used, "7B6A2C5E1F3D4A8B9C0D1E2F3A4B5C6D" );
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE XSystemGetXboxLiveSandboxId( INT32 size, char *id, SIZE_T *used ) override
+    {
+        write_string( id, size, used, "RETRIAL" );
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE XSystemGetAppSpecificDeviceId( INT32 size, char *id, SIZE_T *used ) override
+    {
+        write_string( id, size, used, "4b1f8a52-0d76-4c61-9b0d-2f0a5c1e77aa" );
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE XSystemHandleTrack( XSystemHandleCallback *callback, void *context ) override
+    {
+        (void)callback; (void)context;
+        return S_OK;
+    }
+    BOOLEAN STDMETHODCALLTYPE XSystemIsHandleValid( XSystemHandle handle ) override
+    {
+        (void)handle;
+        return TRUE;
+    }
+    void STDMETHODCALLTYPE XSystemAllowFullDownloadBandwidth( BOOLEAN enable ) override
+    {
+        (void)enable;
+    }
+};
+
+static XSystemObject system_object;
+
+/* XGame: the title id. From the package's own MicrosoftGame.Config (TitleId 7952987A), which
+ * is what the console's service would report. */
+class XGameObject : public IXGameImpl
+{
+public:
+    HRESULT STDMETHODCALLTYPE QueryInterface( REFIID iid, void **out ) override
+    {
+        if ( !out ) return E_POINTER;
+        if ( IsEqualIID( iid, IID_IUnknown ) || IsEqualIID( iid, IID_IXGameImpl ) )
+        {
+            *out = static_cast<IXGameImpl *>( this );
+            return S_OK;
+        }
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return 1; }
+    ULONG STDMETHODCALLTYPE Release() override { return 1; }
+
+    HRESULT STDMETHODCALLTYPE XGameGetXboxTitleId( UINT32 *titleId ) override
+    {
+        if ( titleId ) *titleId = 0x7952987A;
+        return S_OK;
+    }
+};
+
+static XGameObject game_object;
+
 HRESULT WINAPI QueryApiImpl( REFCLSID clsid, REFIID iid, void **out )
 {
     // ------------ FOR FUTURE REFERENCES ------------
@@ -103,6 +236,28 @@ HRESULT WINAPI QueryApiImpl( REFCLSID clsid, REFIID iid, void **out )
         return x_threading_impl->QueryInterface( iid, out );
     }
 
+    if ( IsEqualGUID( clsid, CLSID_XSystemImpl ) )
+    {
+        return system_object.QueryInterface( iid, out );
+    }
+
+    if ( IsEqualGUID( clsid, CLSID_XGameImpl ) )
+    {
+        return game_object.QueryInterface( iid, out );
+    }
+
+    /* Probing is opt-in: a class handed back as numbered slots tells the image's callers
+     * nothing about the real interface, and at least one of them dereferences a field it
+     * expected instead of calling a method (measured: image+0x5A2090 reading -1). */
+    if ( getenv( "XGAMERUNTIME_PROBE" ) )
+    {
+        FIXME( "%s not implemented; returning the numbered probe object.\n",
+               debugstr_guid( &clsid ) );
+        if ( out )
+            *out = probe_object();
+        return S_OK;
+    }
+
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( &clsid ) );
     return REGDB_E_CLASSNOTREG;
 }
