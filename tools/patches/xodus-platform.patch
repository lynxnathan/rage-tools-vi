+/* XPersistentLocalStorage: the title's own storage. The package declares 2048 MB of it, and
+ * the engine wants a path it can mount; without this class the query fails and the engine has
+ * no storage device of its own. */
+class XPersistentLocalStorageObject : public IXPersistentLocalStorageImpl3
+{
+public:
+    HRESULT STDMETHODCALLTYPE QueryInterface( REFIID iid, void **out ) override
+    {
+        if ( !out ) return E_POINTER;
+        if ( IsEqualIID( iid, IID_IUnknown ) || IsEqualIID( iid, IID_IXPersistentLocalStorageImpl3 )
+             || IsEqualIID( iid, IID_IXPersistentLocalStorageImpl2 )
+             || IsEqualIID( iid, IID_IXPersistentLocalStorageImpl ) )
+        {
+            *out = static_cast<IXPersistentLocalStorageImpl3 *>( this );
+            return S_OK;
+        }
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    ULONG STDMETHODCALLTYPE AddRef() override { return 1; }
+    ULONG STDMETHODCALLTYPE Release() override { return 1; }
+
+    HRESULT STDMETHODCALLTYPE XPersistentLocalStorageGetPathSize( SIZE_T *pathSize ) override
+    {
+        if ( pathSize ) *pathSize = 4;
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE XPersistentLocalStorageGetPath( SIZE_T size, char *path,
+                                                              SIZE_T *pathUsed ) override
+    {
+        write_string( path, ( INT32 )size, pathUsed, "G:\\" );
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE XPersistentLocalStorageGetSpaceInfo(
+        XPersistentLocalStorageSpaceInfo *info ) override
+    {
+        if ( info )
+        {
+            info->totalBytes = 2048ull * 1024 * 1024;
+            info->usedBytes = 0;
+            info->totalFreeBytes = info->totalBytes;
+            info->availableFreeBytes = info->totalBytes;
+        }
+        return S_OK;
+    }
+    HRESULT STDMETHODCALLTYPE XPersistentLocalStoragePromptUserForSpaceAsync(
+        UINT64 bytes, XAsyncBlock *async ) override
+    {
+        (void)bytes; (void)async;
+        return E_NOTIMPL;
+    }
