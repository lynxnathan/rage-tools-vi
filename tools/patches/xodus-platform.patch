+    { (void)url; (void)async; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE XNetworkingQuerySecurityInformationForUrlUtf16AsyncResultSize(
+        XAsyncBlock *async, SIZE_T *size ) override
+    { (void)async; if ( size ) *size = 0; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE XNetworkingQuerySecurityInformationForUrlUtf16AsyncResult(
+        XAsyncBlock *async, SIZE_T size, SIZE_T *used, UINT8 *buffer,
+        XNetworkingSecurityInformation **information ) override
+    { (void)async; (void)size; (void)buffer; if ( used ) *used = 0;
+      if ( information ) *information = NULL; return E_NOTIMPL; }
+    HRESULT STDMETHODCALLTYPE XNetworkingVerifyServerCertificate(
+        void *request, const XNetworkingSecurityInformation *information ) override
+    { (void)request; (void)information; return S_OK; }
+    HRESULT STDMETHODCALLTYPE XNetworkingGetConnectivityHint(
+        XNetworkingConnectivityHint *hint ) override
+    {
+        if ( hint ) memset( hint, 0, sizeof( *hint ) );
