+        XAsyncBlock *async ) override
+    {
+        (void)async;
+        return E_NOTIMPL;
+    }
+    HRESULT STDMETHODCALLTYPE XPersistentLocalStorageMountForPackage(
+        const char *packageIdentifier, XPackageMountHandle *mountHandle ) override
+    {
+        (void)packageIdentifier;
+        if ( mountHandle ) *mountHandle = ( XPackageMountHandle )( uintptr_t )1;
+        return S_OK;
+    }
+};
